C {vsource.sym} 1330 -890 0 0 {name=V1 value=1.8 savecurrent=false}
C {code_shown.sym} 2450 -850 0 0 {value="* Include global parameters
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice

*Include the GF180MCU models
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical

.control
* Save the currents flowing through the dummy voltage sources
save I(Vmeas_up) I(Vmeas_down)

* Sweep the output voltage (V_OUT) from 0V to 1.8V in 1mV steps
dc V_OUT 0 1.8 0.001

* Plot the absolute values of the currents
plot abs(I(Vmeas_up)) abs(I(Vmeas_down)) xlabel 'Output Voltage (V)' ylabel 'Charge/Discharge Current (A)' title 'Simple Charge Pump Current Mismatch'
.endc"}
